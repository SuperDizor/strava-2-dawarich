# Strava API credentials (required)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Dawarich (optional - leave blank to skip auto-push)
DAWARICH_URL=https://your-dawarich-instance.com
DAWARICH_API_KEY=your_api_key

# Home location for virtual rides (lat,lon) — anchors virtual activities here
# instead of the virtual world GPS, preventing teleport distance in Dawarich
HOME_LOCATION=41.8781,-87.6298

# Docker persistence (host path mounted as state/, gpx/, and logs/)
APPDATA_PATH=./data
STRAVA_CALLBACK_PORT=8089
STRAVA_CALLBACK_BIND=0.0.0.0

# Runtime paths; compose supplies these defaults inside the container
DATA_DIR=/data
STATE_DIR=/data/state
GPX_DIR=/data/gpx
LOG_DIR=/data/logs
LOG_TO_FILE=true

# Optional homelab root CA used by an HTTPS Dawarich reverse proxy
CUSTOM_CA_PATH=./certs/rootCA.pem

# Read-only Dawarich overlap analysis
DAWARICH_DEDUP_RADIUS_METERS=200
DAWARICH_DEDUP_REPORT_DIR=/data/state/dedup-reports
